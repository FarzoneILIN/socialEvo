{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/socialevo/episode_summary.schema.json",
  "title": "SocialEvo episode summary",
  "type": "object",
  "required": ["run_id", "task_id", "utility", "status"],
  "properties": {
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "utility": {"type": ["number", "null"]},
    "status": {"type": "string"},
    "individual_utilities": {"type": "object"},
    "cost": {"type": "object"},
    "organization": {"type": "object"},
    "relation_events": {"type": "array"},
    "intervention": {"type": ["object", "null"]},
    "failure_class": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}

