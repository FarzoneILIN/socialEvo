{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/socialevo/experiment.schema.json",
  "title": "SocialEvo experiment configuration",
  "type": "object",
  "required": ["experiment_id", "version", "status", "split", "protocol", "budget", "seeds"],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9_\\-]+$"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "dev", "frozen", "retired"]},
    "split": {"enum": ["public", "development", "private"]},
    "protocol": {"type": "string"},
    "budget": {"type": "object"},
    "seeds": {"type": "object"},
    "expected_artifacts": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

